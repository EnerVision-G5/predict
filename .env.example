# Copier en .env, qui n'est jamais commité (voir .gitignore).
# Ce fichier ne contient aucun secret réel, seulement des valeurs d'exemple.
#
# Rien ici n'est lu directement par le code : `conf/base.yaml` référence ces
# variables par `${NOM}`, et c'est lui la source de vérité de la
# configuration. Un réglage qui n'apparaît pas dans conf/ n'existe pas, même
# s'il est écrit ici.
#
# Deux jeux de valeurs pour les mêmes cibles, parce que « localhost » ne
# désigne pas la même machine selon d'où le code tourne. Depuis un conteneur,
# localhost c'est le conteneur lui-même. Les variables *_CONTAINER sont celles
# que docker compose injecte, les autres servent aux commandes lancées sur le
# poste.

# --- Poste de développement -------------------------------------------------

# API Mock IoT, source des mesures. Le port fait partie de la valeur : aucune
# adresse n'est en dur dans le code.
MOCK_API_URL=http://10.105.200.45:8000

# Serveur MLflow, qu'il tourne en local ou via docker compose.
MLFLOW_TRACKING_URI=http://localhost:5000

# Racine des artefacts. Un chemin relatif désigne le disque, une URI s3:// un
# stockage objet. Les deux traversent le même code.
PREDICT_STORAGE_ROOT=data

# Couche de configuration superposée à conf/base.yaml : conf/${PREDICT_ENV}.yaml.
PREDICT_ENV=local

# --- Services de docker compose ---------------------------------------------

# Même cible, vue depuis un conteneur. C'est bien la même IP qu'au-dessus et
# non `host.docker.internal` : l'API Mock tourne sur une autre machine du
# réseau, pas sur l'hôte Docker. `host.docker.internal` désignerait le poste
# de développement, où il n'y a rien à interroger.
MOCK_API_URL_CONTAINER=http://10.105.200.45:8000

# --- Ports exposés ----------------------------------------------------------

MLFLOW_PORT=5000
SERVING_PORT=8000

# --- Entraînement et service ------------------------------------------------

MLFLOW_EXPERIMENT=enervision-consumption

# Alias résolu par le service d'inférence au démarrage. Promouvoir un modèle se
# fait en déplaçant cet alias dans MLflow, sans redéployer le service ; le
# retour arrière est le même geste en sens inverse.
SERVING_MODEL_URI=models:/enervision_xgboost@champion

# --- TimescaleDB : la couche brute ------------------------------------------
#
# Ce n'est pas une option : le collecteur y écrit les mesures et l'ETL les y
# relit. La base est portée par api/enervision-db/docker-compose.yml, qui
# détient le schéma figé v1.0. La migration 03_mesure_imputation.sql doit y
# avoir été appliquée, sans quoi l'ETL échouera en reposant
# `consumption_kw_imputed`.
DATABASE_URL=postgresql+psycopg://enervision:changeme-mot-de-passe-fort@localhost:5432/enervision
# Même base, vue depuis un conteneur. host.docker.internal si elle tourne sur
# le poste ; son IP réseau si elle tourne ailleurs.
DATABASE_URL_CONTAINER=postgresql+psycopg://enervision:changeme-mot-de-passe-fort@host.docker.internal:5432/enervision

# --- Stockage objet Garage (profil `garage`) --------------------------------
#
# Les partitions de variables, et elles seules. Le disque local suffit au
# développement : laisser PREDICT_STORAGE_ROOT=data et AWS_ENDPOINT_URL vide.
#
# Pour passer sur Garage :
#   docker compose --profile garage up -d garage garage-init
#   docker compose logs garage-init      # relève la clé et le secret générés
# puis reporter ci-dessous, et poser PREDICT_STORAGE_ROOT=s3://enervision.
GARAGE_BUCKET=enervision
GARAGE_KEY_NAME=predict
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
# Générés par `garage key create`, jamais choisis à la main. Vides tant que le
# stockage objet n'est pas utilisé.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Vide = disque local. http://garage:3900 depuis un conteneur,
# http://localhost:3900 depuis le poste.
AWS_ENDPOINT_URL=
