# Copier en .env, qui n'est jamais commité (voir .gitignore).
# Ce fichier ne contient aucun secret réel, seulement des valeurs d'exemple.
#
# Deux jeux de valeurs, parce que "localhost" ne désigne pas la même machine
# selon d'où le code tourne. Depuis un conteneur, localhost c'est le conteneur
# lui-même : l'ETL irait chercher la base chez lui et échouerait, ou pire,
# joindrait un service homonyme. Les variables *_CONTAINER sont celles que
# docker compose injecte dans le service etl, les autres servent aux commandes
# lancées directement sur le poste.

# --- Poste de développement (PYTHONPATH=src python -m etl.pipeline) ---

# Base TimescaleDB portée par api/enervision-db/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://enervision:changeme-mot-de-passe-fort@localhost:5432/enervision

# API Mock IoT, source des mesures. Le port fait partie de la valeur : aucune
# adresse n'est en dur dans le code, l'ETL concatène cette URL et le chemin.
# Quand le formateur fournit l'IP de l'API Mock, remplacer localhost par elle
# ICI ET dans MOCK_API_URL_CONTAINER plus bas : http://IP_API_MOCK:8000
MOCK_API_URL=http://localhost:8000

# Serveur MLflow, qu'il tourne en local ou via docker compose.
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Service etl de docker compose ---

# Mêmes cibles, vues depuis le conteneur. host.docker.internal résout la
# machine hôte, y compris sous Linux grâce au extra_hosts du compose.
DATABASE_URL_CONTAINER=postgresql+psycopg://enervision:changeme-mot-de-passe-fort@host.docker.internal:5432/enervision
# host.docker.internal ne vaut que si l'API Mock tourne sur cette machine. Si
# le formateur fournit une IP, c'est elle qu'il faut mettre ici, pas
# host.docker.internal, qui désignerait alors la mauvaise machine.
MOCK_API_URL_CONTAINER=http://host.docker.internal:8000

# --- Commun ---

MLFLOW_PORT=5000
MLFLOW_EXPERIMENT=enervision-consumption
ETL_BATCH_SIZE=1000
ETL_REQUEST_TIMEOUT_S=30


# --- Ingestion continue (etl.poller) ---------------------------------------
# Cadence d'interrogation de /current, en secondes. La source produit une
# mesure par minute et par site : descendre plus bas relit la même valeur.
ETL_POLL_INTERVAL_S=60
# Reprises immédiates sur échec réseau avant d'abandonner le site pour ce
# tick. La vraie relance est le tick suivant.
ETL_POLL_RETRIES=1
ETL_POLL_BACKOFF_S=2
# Timeout d'un appel à /current. Plus court que ETL_REQUEST_TIMEOUT_S : un
# site muet ne doit pas retarder les six autres.
ETL_POLL_TIMEOUT_S=10
# Seuil de retard d'ingestion au-delà duquel le journal passe en WARNING.
ETL_LAG_WARNING_S=180
# Chemin de la mesure courante sur l'API Mock IoT.
MOCK_API_CURRENT_PATH=/api/v1/sites/{site_id}/current
