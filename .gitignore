__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Backend store et artefacts MLflow : c'est là que vivent les runs et les
# modèles enregistrés. Ils sont versionnés par MLflow, jamais par Git.
mlruns/

# Couches d'artefacts : partitions brutes et variables. Elles sont
# reproductibles à partir de la source et d'une commande datée, ce qui est
# exactement ce qu'un dépôt de code n'a pas à porter.
data/

# Sorties de notebooks.
.ipynb_checkpoints/

# Secrets d'exécution. Seul .env.example est versionné.
.env
