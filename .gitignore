__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Backend store et artefacts MLflow : c'est là que vivent les runs et les
# modèles enregistrés. Ils sont versionnés par MLflow, jamais par Git.
mlruns/

# Couches d'artefacts : partitions brutes et variables. Elles sont
# reproductibles à partir de la source et d'une commande datée, ce qui est
# exactement ce qu'un dépôt de code n'a pas à porter.
data/

# Historique de référence : deux années horaires par site, vingt-quatre
# mégaoctets de CSV figés. Ils vivent sur le stockage objet, d'où
# `python -m collector.datasets` les lit — un dépôt de code n'a pas à faire
# transiter ce poids à chaque clone, et Git ne sait rien en faire qu'un
# stockage objet ne fasse mieux.
datasets/

# Sorties de notebooks.
.ipynb_checkpoints/

# Secrets d'exécution. Seul .env.example est versionné.
.env

# Rapports de couverture, produits à chaque exécution de pytest --cov.
.coverage
coverage.xml

# Traces du service lancé en tâche de fond par le job DAST, reproduites à
# l'identique quand on rejoue le scan ZAP en local.
uvicorn.log
uvicorn.pid
